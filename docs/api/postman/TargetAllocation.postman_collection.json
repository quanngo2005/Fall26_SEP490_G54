                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Confirm (DRAFT -> ACTIVE, sinh month/day)",
      "item": [
        {
          "name": "Confirm KD -> 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/target-assignments/{{deptKdYearId}}/confirm",
              "host": ["{{baseUrl}}"],
