      ]
    },
    {
      "name": "5. Tree",
      "item": [
        {
          "name": "Tree branch/year with compareYear -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/target-assignments/tree?branchId={{branchId}}&year={{year}}&compareYear={{compareYear}}",
              "host": ["{{baseUrl}}"],
              "path": ["target-assignments", "tree"],
              "query": [
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                },
                {
                  "key": "year",
                  "value": "{{year}}"
                },
                {
                  "key": "compareYear",
                  "value": "{{compareYear}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "function findNode(nodes, pred) {",
                  "  for (const n of nodes || []) { if (pred(n)) return n; const c = findNode(n.children, pred); if (c) return c; }",
                  "  return null;",
                  "}",
                  "const data = pm.response.json().data;",
                  "const b = findNode(data, x => x.id === pm.collectionVariables.get('branchYearId'));",
                  "pm.test('Branch-year ACTIVE', () => pm.expect(b && b.status).to.eql('ACTIVE'));",
                  "pm.test('Allocated = target', () => pm.expect(Number(b.allocatedValue)).to.eql(Number(b.targetValue)));",
                  "const kd = findNode(data, x => x.id === pm.collectionVariables.get('deptKdYearId'));",
                  "pm.test('KD has 4 quarters', () => pm.expect(kd.children.filter(c => c.periodType === 'QUARTER').length).to.eql(4));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Re-allocate ACTIVE (versioning)",
      "item": [
        {
          "name": "Change ACTIVE departments without reason -> 400",
