                ]
              }
            }
          ]
        },
        {
          "name": "Confirm GD -> 200 (branch-year ACTIVE)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/target-assignments/{{deptGdYearId}}/confirm",
              "host": ["{{baseUrl}}"],
