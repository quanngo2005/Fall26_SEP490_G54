            "period-allocations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 (Forbidden)', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET without token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/target-assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "target-assignments"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 (Unauthorized)', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
