POSTGRES_DB=bpms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
# JWT signing key (>= 32 bytes). Generate: openssl rand -base64 48
# Placeholder is accepted only in Development; production refuses it.
JWT_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Host port for the frontend container (change if 8080 is taken).
FRONTEND_PORT=8080
# nginx routes by Host: frontend and API have separate origins, both without prefixes.
# Update origins when changing FRONTEND_PORT or deploying to real domains.
FRONTEND_HOST=localhost
API_HOST=api.localhost
FRONTEND_ORIGIN=http://localhost:8080
API_URL=http://api.localhost:8080
APP_VERSION=dev
# Local development only. Set a private password in docker/.env before enabling.
MIGRATOR_ENVIRONMENT=Development
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@bpms.com
BOOTSTRAP_ADMIN_PASSWORD=
# Password for seeded demo accounts (NV001-NV006). Empty = no demo accounts.
SEED_DEMO_PASSWORD=
