{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=bpms_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Cors": {
    "Origins": ["http://localhost:4200", "http://127.0.0.1:4200", "http://localhost:8080"]
  },
  "Jwt": {
    "Issuer": "G54.Api",
    "Audience": "G54.Frontend"
  },
  "Authentication": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Storage": {
    "EvidencePath": "uploads/evidence"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "WorkOverdue": {
    "Enabled": true,
    "IntervalMinutes": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] [{UserId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
